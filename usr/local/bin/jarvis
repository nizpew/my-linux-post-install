#!/bin/bash

notify-send "Debug" "Iniciando script"



cd ~/J.A.R.V.I.S 


# Espera até o runner iniciar
ollama serve &

notify-send "Jarvis" "Ollama pronto! Iniciando main.py"






source venv/bin/activate
python3.10 main.py & 
notify-send "msg" "Jarvis escutando"



cd koki
npm install
npm start &

cd ..
chromium http://localhost:3000/
