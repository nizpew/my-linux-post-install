#!/bin/sh
# todo list, minimal and fast
# args: l, k, a, d, r , rr, h.



#no arg
if [ "$#" = "0" ] ; then

    cat ./Documents/constant-files/estadio-creds-virgem

fi


#'-m' = modify raw list
if [ "$1" = "-m" ] ; then
    vim ./Documents/constant-files/estadio-creds-virgem
fi




# '-h' = help
if [ "$1" = "-h" ] ; then
    echo "args: l, k, a, d.
Syntax: todolist argument TASKNUMBER
	'-l' = list tasks

	'-r' = renew tasks

	'-rr' = renew tasks daily automatically

	'-d' = #add DONE to tasks

	'-m' = modify raw list
	"
fi
